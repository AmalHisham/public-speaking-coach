# Local development
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=public_speaking_coach
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Optional connection query parameters
# DATABASE_QUERY__sslmode=disable

# Clerk authentication
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# OpenAI
OPENAI_API_KEY=
TRANSCRIPTION_MAX_UPLOAD_BYTES=26214400

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Neon production example
# DATABASE_HOST=ep-example-123456.us-east-1.aws.neon.tech
# DATABASE_PORT=5432
# DATABASE_NAME=neondb
# DATABASE_USER=your_neon_user
# DATABASE_PASSWORD=your_neon_password
